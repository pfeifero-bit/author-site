# ═══════════════════════════════════════════════════════════════════════
# Public site URL used for sitemaps, OG tags, and JSON-LD canonical URLs.
# ═══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=https://aifundraisingfornonprofits.com

# ═══════════════════════════════════════════════════════════════════════
# Inquiry routing — server-only.
# The /api/inquiry route (called by WorkInquiryForm) uses Resend to
# deliver form submissions to INQUIRY_RECIPIENT, with Formspree as a
# fallback if RESEND_API_KEY is empty.
#
# NOTE: WorkInquiryForm currently only renders inside /work-with-us,
# which unconditionally 301-redirects to /speaking at the CDN level, so
# no live user path exercises this route today. Kept wired in case
# /work-with-us is revived (see NEXT_PUBLIC_WORK_WITH_US_LIVE below).
# ═══════════════════════════════════════════════════════════════════════
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dale Nirvani Pfeifer <dale@aifundraisingfornonprofits.com>
INQUIRY_RECIPIENT=dale@aifundraisingfornonprofits.com
FORMSPREE_INQUIRY_ENDPOINT=

# ═══════════════════════════════════════════════════════════════════════
# Pre-orders live? When "true", the retailer cluster (currently just
# Amazon in site.ts) becomes visible across the site with clickable
# links. Default false until additional retailer URLs are confirmed.
# Client-visible so the Hero can render conditionally.
# ═══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_PREORDERS_LIVE=false

# ═══════════════════════════════════════════════════════════════════════
# Work-with-us page live? When "true", /work-with-us is reachable, in
# nav, sitemap, and indexed. When off (default), the page returns 404
# and is disallowed in robots. IMPORTANT: next.config.mjs also 301s
# this route to /speaking at the CDN, so flipping this flag alone will
# NOT restore the page — remove the redirect first.
# ═══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_WORK_WITH_US_LIVE=false

# ═══════════════════════════════════════════════════════════════════════
# Analytics. Set ONE of these. Leave both blank to disable.
# ═══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
